# Anthropic Claude API (opcional; necessário apenas para gerar insights)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (local development)
DATABASE_URL="file:./dev.db"

# Para usar PostgreSQL em produção, substitua o valor acima por uma URL de conexão PostgreSQL.
# Exemplo:
# DATABASE_URL="postgresql://username:password@localhost:5432/diario_do_ser?schema=public"